{
  "name": "lms3/lms3h5p",
  "description": "H5P Platform Integration Plugin for TYPO3 CMS",
  "type": "typo3-cms-extension",
  "version": "4.0.0",
  "license": "GPL-2.0-or-later",
  "authors": [
    {
      "name": "Sagar Desai",
      "email": "sagardesai1990@gmail.com"
    }
  ],
  "require": {
    "php": "^8.2",
    "typo3/cms-core": "^13.4",
    "ext-zip": "*",
    "h5p/h5p-core": "dev-master",
    "h5p/h5p-editor": "dev-master"
  },
  "replace": {
    "typo3-ter/lms3h5p": "self.version"
  },
  "autoload": {
    "psr-4": {
      "LMS3\\Lms3h5p\\": "Classes"
    }
  },
  "extra": {
    "typo3/cms": {
      "extension-key": "lms3h5p"
    }
  }
}
